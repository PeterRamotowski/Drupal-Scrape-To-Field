<?php

/**
 * @file
 * Primary module hooks for Scrape to field module.
 */

/**
 * Implements hook_module_preuninstall().
 *
 * Delegates all cleanup logic to the ModuleUninstallHandler service so it
 * can be tested in isolation and injected with dependencies properly.
 */
function scrape_to_field_module_preuninstall($module) {
  if ($module !== 'scrape_to_field') {
    return;
  }

  \Drupal::service('scrape_to_field.uninstall_handler')->preUninstall();
}
